{
  "name": "cadenway-tooling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm -r run build",
    "test": "vitest run --project unit",
    "test:architecture": "pnpm build && node --test tests/architecture/*.spec.mjs && vitest run packages/nest-testing/src/architecture.spec.ts",
    "test:fixtures": "vitest run --project unit packages/nest-testing/src/fixtures/fixtures.spec.ts",
    "test:packaging": "node --test tests/packaging/archives.test.mjs",
    "quality": "pnpm format:check && pnpm typecheck && pnpm test:architecture && pnpm test --exclude \"**/architecture.spec.ts\" && pnpm test:packaging",
    "release": "pnpm build && changeset publish",
    "changeset": "changeset",
    "test:integration": "vitest run --project integration",
    "test:integration:service-kit": "tsc -p packages/nest-testing/tests/service-kit/tsconfig.json --noEmit && vitest run --project service-kit"
  },
  "devDependencies": {
    "@cadenway/angular-testing": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@types/node": "catalog:",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
