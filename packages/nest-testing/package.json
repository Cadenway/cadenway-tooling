{
  "name": "@cadenway/nest-testing",
  "version": "0.6.0",
  "description": "Test helpers for the Cadenway NestJS services and gateways.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cadenway/cadenway-tooling.git",
    "directory": "packages/nest-testing"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./architecture": {
      "types": "./dist/architecture.d.ts",
      "default": "./dist/architecture.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure.d.ts",
      "default": "./dist/infrastructure.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/pg": "^8.23.1",
    "msw": "^3.0.5",
    "testcontainers": "^12.2.1",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@cadenway/nest-messaging": "^0.0.1 || ^0.2.0 || ^0.8.0",
    "@nestjs/testing": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "supertest": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@cadenway/nest-messaging": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/testing": "catalog:",
    "@opentelemetry/api": "^1.10.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.7"
  }
}
